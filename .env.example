# Backend API base URL (required for auth and API calls)
REACT_APP_BACKEND_BASE_URL=https://api.example.com

# Optional fallback key name supported by appConfig.js
# BACKEND_BASE_URL=https://api.example.com

# Optional bearer token used for signup flow (if your backend expects it)
REACT_APP_SIGNUP_BEARER_TOKEN=

# Optional fallback key name supported by appConfig.js
# SIGNUP_BEARER_TOKEN=

# Razorpay publishable key (safe for frontend; secret keys must never be here)
REACT_APP_RAZORPAY_KEY_ID=

# Local UI-only payment mode (true/false)
REACT_APP_PAYMENT_DEMO=false

# Optional Google Analytics GA4 Measurement ID (e.g. G-XXXXXXXXXX)
REACT_APP_GA_MEASUREMENT_ID=

# Optional custom backend paths for Razorpay endpoints
REACT_APP_RAZORPAY_ORDER_PATH=/payments/create-order
REACT_APP_RAZORPAY_VERIFY_PATH=/payments/verify
REACT_APP_RAZORPAY_FAILED_PATH=/payments/failed
REACT_APP_RAZORPAY_BOOKING_STATUS_PATH_PREFIX=/payments/booking
