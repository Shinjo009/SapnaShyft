#
# Cloudflare Pages / Netlify compatible headers file.
# CRA ships every hashed asset under /static/**; changing content produces a
# new hash, so these files are safe to cache for a full year.
#

# All hashed JS/CSS/media chunks — immutable for a year
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts copied into build output (if any) — same treatment
/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# HTML shell must revalidate every request so users pick up new builds
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker + manifest must not be long-cached
/serviceWorker.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=3600

# robots.txt must be served exactly as authored. If Cloudflare's "AI Audit /
# Bot Management → Content-Signal" feature is enabled on this zone it will
# inject a non-standard `Content-Signal:` line into the response body and
# Lighthouse flags that as a robots.txt parse error. Disable that toggle in
# the Cloudflare dashboard (Security → Bots → AI Audit) in addition to this
# header, which pins the correct mime-type and short cache.
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: all

# Favicons / PWA icons — cache for a day
/favicon.ico
  Cache-Control: public, max-age=86400
/logo192.png
  Cache-Control: public, max-age=86400
/logo512.png
  Cache-Control: public, max-age=86400
/super-shyft-favicon.png
  Cache-Control: public, max-age=86400

# LCP background. Served from /public/ with a stable (unhashed) filename so
# index.html can <link rel="preload"> it. Cache for 30 days — long enough that
# repeat-visit Lighthouse runs stop flagging "use efficient cache lifetimes",
# short enough that a future artwork change rolls out within a month even
# without a filename change. If you do change the image, rename the file.
/BG-1.png
  Cache-Control: public, max-age=2592000
